{
    "version": 2,
    "builds": [
        {
            "src" : "./index.js",
            "use" : "@vercel/node",
            "config": {
                "includeFiles": "rust_algos/pkg/**"
            }
        }
    ],
    "routes": [
        {
            "src" : "/(.*)",
            "dest": "/"
        }
    ]
}